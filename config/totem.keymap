#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y   &kp U       &kp I       &kp O       &kp P
                HRML(A,     S,          D,          F)          &kp G           &kp H   HRMR(J,     K,          L,          SEMI)
                &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N   &kp M       &kp COMMA   &kp DOT     &kp SLASH
                                        &lt MEDIA ESC &lt NAV SPACE &kp TAB     &kp ENTER &lt MEDIA BSPC &lt NUM DEL
            >;
        };

        nav_layer {
            bindings = <
                &trans      &trans      &trans      &trans      &trans          &kp HOME &kp PG_DN   &kp PG_UP   &kp END     &kp CAPS
                &sk LGUI    &sk LALT    &sk LCTRL   &sk LSHFT   &trans          &kp LEFT &kp DOWN    &kp UP      &kp RIGHT   &trans
                &trans      &trans      &trans      &trans      &trans          &kp K_UNDO &kp K_CUT &kp K_COPY  &kp K_PASTE &kp K_REDO
                                        &trans      &trans      &trans          &trans    &trans     &trans
            >;
        };

        num_layer {
            bindings = <
                &kp LBKT    &kp N7      &kp N8      &kp N9      &kp RBKT        &trans  &trans      &trans      &trans      &trans
                &kp SEMI    &kp N4      &kp N5      &kp N6      &kp EQUAL       &trans  &sk RSHFT   &sk RCTRL   &sk RALT    &sk RGUI
                &kp GRAVE   &kp N1      &kp N2      &kp N3      &kp BSLH        &trans  &trans      &trans      &trans      &trans
                                        &kp DOT     &kp N0      &kp MINUS       &trans  &trans      &trans
            >;
        };

        sym_layer {
            bindings = <
                &kp LBRC    &kp AMPS    &kp ASTRK   &kp LPAR    &kp RBRC        &trans  &trans      &trans      &trans      &trans
                &kp COLON   &kp DLLR    &kp PRCNT   &kp CARET   &kp PLUS        &trans  &sk RSHFT   &sk RCTRL   &sk RALT    &sk RGUI
                &kp TILDE   &kp EXCL    &kp AT      &kp HASH    &kp PIPE        &trans  &trans      &trans      &trans      &trans
                                        &kp LPAR    &kp RPAR    &kp UNDER       &trans  &trans      &trans
            >;
        };

        fun_layer {
            bindings = <
                &kp F12     &kp F7      &kp F8      &kp F9      &kp PSCRN       &trans  &trans      &trans      &trans      &trans
                &kp F11     &kp F4      &kp F5      &kp F6      &trans          &trans  &sk RSHFT   &sk RCTRL   &sk RALT    &sk RGUI
                &kp F10     &kp F1      &kp F2      &kp F3      &trans          &trans  &trans      &trans      &trans      &trans
                                        &trans      &kp SPACE   &trans          &trans  &trans      &trans
            >;
        };

        mouse_layer {
            bindings = <
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans          &trans  &trans      &trans
            >;
        };

        media_layer {
            bindings = <
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans          &trans  &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans          &trans  &trans      &trans
            >;
        };
    };
};