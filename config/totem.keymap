#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define ___ &trans

#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH0 LH1 LH2 RH0 RH1 RH2


ZMK_HOLD_TAP(hml, 
    flavor = "balanced";
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_LAYER(default_layer,

 // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
          &kp Q         &kp W         &kp E          &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
     // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
          &hrm LGUI A   &hml LALT S   &hml LCTRL D  &hml LSHFT F  &kp G             &kp H         &hmr RSHFT J  &hmr RCTRL K  &hmr LALT L   &hmr SEMI
     // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
&mt LEFT_SHIFT LEFT_WIN  &kp Z  &kp X       &kp C        &kp V        &kp B      &kp N      &kp M            &kp COMMA    &kp DOT  &kp SLASH  &lt 2 BSPC
     // ╰─────────────────────────────────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────────────────────────────────╯
                                                    &lt 3 ESC    &lt 1 SPACE  &kp TAB    &kp ENTER  &lt 3 BACKSPACE  &lt 4 DEL
     //  

)

ZMK_LAYER(nav_layer,
 &trans    &trans    &trans     &trans     &trans    &kp K_REDO  &kp K_PASTE    &kp K_COPY     &kp K_CUT  &kp K_UNDO
        &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &trans    &kp LEFT    &kp DOWN       &kp UP         &kp RIGHT  &kp CAPSLOCK
&trans  &trans    &trans    &trans     &trans     &trans    &kp HOME    &kp HOME       &kp PAGE_DOWN  &kp END    &kp END       &trans
                            &trans     &trans     &trans    &kp ENTER   &kp BACKSPACE  &kp DELETE 
)

ZMK_LAYER(num_layer,
&kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans
        &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &sk RSHFT  &sk RCTRL  &sk RALT  &sk RGUI
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
)

ZMK_LAYER(sym_layer,
&kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC     &trans  &trans     &trans     &trans    &trans
        &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &trans  &sk RSHFT  &sk RCTRL  &sk RALT  &sk RGUI
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &trans  &trans     &trans     &trans    &trans    &trans
                             &kp LPAR   &kp RPAR   &kp UNDER    &trans  &trans     &trans
)

ZMK_LAYER(fun_layer,
&kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN    &trans  &trans          &trans            &trans        &trans
        &kp F11  &kp F4  &kp F5  &kp F6     &trans             &trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_WIN
&trans  &kp F10  &kp F1  &kp F2  &kp F3     &trans             &trans  &trans          &trans            &trans        &trans        &trans
                         &trans  &kp SPACE  &trans             &trans  &trans          &trans

)